# Milk Payment Input and Type Conversion

# Read farmer details
farmer_id = input("Enter Farmer ID: ")
shift = input("Enter Shift: ")

try:
    litres = float(input("Enter milk quantity: "))
    fat = float(input("Enter fat percentage: "))
    snf = float(input("Enter SNF percentage: "))

    # Validate inputs
    if litres <= 0:
        print("Invalid milk quantity")

    elif not (2.0 <= fat <= 7.0):
        print("Invalid fat percentage")

    elif snf < 0:
        print("Invalid SNF percentage")

    else:
        # Calculate payment
        rate = 30 + round((fat - 3.5) / 0.1) * 0.40 \
                  + round((snf - 8.5) / 0.1) * 0.30

        amount = round(litres * rate, 2)

        # Display results
        print("\n----- Milk Payment -----")
        print(f"{'Farmer ID':<15}: {farmer_id}")
        print(f"{'Shift':<15}: {shift}")
        print(f"{'Milk Quantity':<15}: {litres:.2f}")
        print(f"{'Fat Percentage':<15}: {fat:.2f}%")
        print(f"{'SNF Percentage':<15}: {snf:.2f}%")
        print(f"{'Rate per Litre':<15}: Rs. {rate:.2f}")
        print(f"{'Payment Amount':<15}: Rs. {amount:.2f}")

except ValueError:
    print("Invalid input! Please enter numeric values.")
