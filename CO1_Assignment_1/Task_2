from decimal import Decimal

# Explore data types
print("----- Data Types -----")
print(type(10))
print(type(10.0))
print(type("10"))
print(type(True))
print(type([10, 8.5]))

# Explore division operators
print("\n----- Division Operators -----")
print("7 / 2 =", 7 / 2)
print("7 // 2 =", 7 // 2)
print("7 % 2 =", 7 % 2)
print("-7 // 2 =", -7 // 2)

# Floating-point calculation
print("\n----- Floating-Point Error -----")
print("0.1 + 0.2 =", 0.1 + 0.2)
print("0.1 + 0.2 == 0.3:", 0.1 + 0.2 == 0.3)

# Accurate decimal calculation
print("\n----- Decimal Calculation -----")
print("Decimal addition:",
      Decimal("0.1") + Decimal("0.2"))
print("Decimal comparison:",
      Decimal("0.1") + Decimal("0.2") == Decimal("0.3"))

# Milk payment calculation
print("\n----- Milk Payment -----")
payments = ["33.40"] * 1000 + ["0.10"] * 3

total_float = 0.0
for amount in payments:
    total_float += float(amount)

total_decimal = sum(
    (Decimal(amount) for amount in payments),
    Decimal("0.00")
)

print("Float Total:", total_float)
print("Decimal Total:", total_decimal)

# Convert Decimal to float
amount = "0.10"
print("Decimal from string:", Decimal(amount))
print("Decimal from float:", Decimal(float(amount)))
