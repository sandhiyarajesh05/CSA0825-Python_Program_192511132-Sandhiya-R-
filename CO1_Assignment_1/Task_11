from decimal import Decimal, ROUND_HALF_UP

# Rate constants
BASE_RATE = Decimal("30.00")
FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")
STANDARD_FAT = Decimal("3.5")
STANDARD_SNF = Decimal("8.5")
STEP_SIZE = Decimal("0.1")


def rate_per_litre(fat, snf):
    """Calculate the rate per litre."""
    fat = Decimal(str(fat))
    snf = Decimal(str(snf))

    fat_steps = ((fat - STANDARD_FAT) / STEP_SIZE).quantize(
        Decimal("1"), rounding=ROUND_HALF_UP
    )
    snf_steps = ((snf - STANDARD_SNF) / STEP_SIZE).quantize(
        Decimal("1"), rounding=ROUND_HALF_UP
    )

    rate = BASE_RATE + fat_steps * FAT_STEP_VALUE \
           + snf_steps * SNF_STEP_VALUE

    return rate.quantize(Decimal("0.01"))


def payout(litres, fat, snf):
    """Calculate the farmer's payment."""
    litres = Decimal(str(litres))
    amount = litres * rate_per_litre(fat, snf)

    return amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)


# Test payments
payments = [
    ("F101", "10", "3.5", "8.5"),
    ("F102", "8.5", "4.2", "8.7"),
    ("F103", "12", "3.1", "8.3")
]

total = Decimal("0.00")

print("----- Milk Payment Report -----")

for farmer_id, litres, fat, snf in payments:
    rate = rate_per_litre(fat, snf)
    amount = payout(litres, fat, snf)
    total += amount

    print(f"{farmer_id}: Rate = Rs. {rate:.2f}, "
          f"Payment = Rs. {amount:.2f}")

print(f"Total Payment: Rs. {total:.2f}")
