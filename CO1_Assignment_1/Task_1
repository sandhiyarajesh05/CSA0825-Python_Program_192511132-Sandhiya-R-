# Milk Payment Calculation System

# Constants
BASE_RATE = 30.00
FAT_STEP_VALUE = 0.40
SNF_STEP_VALUE = 0.30
STANDARD_FAT = 3.5
STANDARD_SNF = 8.5
MIN_FAT = 2.0
MAX_FAT = 7.0
DAYS = 10

# Get farmer details
farmer_id = input("Enter Farmer ID: ")
shift = input("Enter Shift (Morning/Evening): ")
litres = float(input("Enter milk quantity in litres: "))
fat = float(input("Enter fat percentage: "))
snf = float(input("Enter SNF percentage: "))

# Validate the input
if litres < 0:
    print("Invalid milk quantity")

elif fat < MIN_FAT or fat > MAX_FAT:
    print("Invalid fat percentage")

elif snf < 0:
    print("Invalid SNF percentage")

elif shift.lower() not in ["morning", "evening"]:
    print("Invalid shift")

else:
    # Calculate fat and SNF steps
    fat_steps = round((fat - STANDARD_FAT) / 0.1)
    snf_steps = round((snf - STANDARD_SNF) / 0.1)

    # Calculate rate per litre
    rate = BASE_RATE + (fat_steps * FAT_STEP_VALUE) + \
           (snf_steps * SNF_STEP_VALUE)

    rate = round(rate, 2)

    # Calculate payment
    amount = round(litres * rate, 2)
    ten_day_total = round(amount * DAYS, 2)

    # Display the result
    print("\n----- Milk Payment Receipt -----")
    print("Farmer ID:", farmer_id)
    print("Shift:", shift)
    print("Milk Quantity:", litres, "litres")
    print("Fat Percentage:", fat, "%")
    print("SNF Percentage:", snf, "%")
    print("Rate per Litre: Rs.", format(rate, ".2f"))
    print("Payment Amount: Rs.", format(amount, ".2f"))
    print("Ten-Day Total: Rs.", format(ten_day_total, ".2f"))
