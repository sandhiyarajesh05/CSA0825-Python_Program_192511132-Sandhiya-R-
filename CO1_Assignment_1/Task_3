from decimal import Decimal, ROUND_HALF_UP

# Constants
BASE_RATE = Decimal("30.00")
FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")
STANDARD_FAT = Decimal("3.5")
STANDARD_SNF = Decimal("8.5")
DAYS = 10

# Get farmer details
farmer_id = input("Enter Farmer ID: ")
shift = input("Enter Shift (Morning/Evening): ")
litres = Decimal(input("Enter milk quantity: "))
fat = Decimal(input("Enter fat percentage: "))
snf = Decimal(input("Enter SNF percentage: "))

# Validate inputs
if litres <= 0:
    print("Invalid milk quantity")

elif not (Decimal("2.0") <= fat <= Decimal("7.0")):
    print("Invalid fat percentage")

elif snf < 0:
    print("Invalid SNF percentage")

elif shift.lower() not in ["morning", "evening"]:
    print("Invalid shift")

else:
    # Calculate adjustment steps
    fat_steps = int(
        ((fat - STANDARD_FAT) / Decimal("0.1"))
        .quantize(Decimal("1"), rounding=ROUND_HALF_UP)
    )

    snf_steps = int(
        ((snf - STANDARD_SNF) / Decimal("0.1"))
        .quantize(Decimal("1"), rounding=ROUND_HALF_UP)
    )

    # Calculate rate
    rate = (
        BASE_RATE
        + Decimal(fat_steps) * FAT_STEP_VALUE
        + Decimal(snf_steps) * SNF_STEP_VALUE
    )

    # Calculate payment
    amount = (litres * rate).quantize(
        Decimal("0.01"), rounding=ROUND_HALF_UP
    )

    ten_day_total = (amount * DAYS).quantize(
        Decimal("0.01"), rounding=ROUND_HALF_UP
    )

    # Display receipt
    print("\n----- Milk Payment Receipt -----")
    print("Farmer ID:", farmer_id)
    print("Shift:", shift)
    print("Milk Quantity:", litres, "litres")
    print("Fat Percentage:", fat, "%")
    print("SNF Percentage:", snf, "%")
    print("Rate per Litre: Rs.", format(rate, ".2f"))
    print("Payment Amount: Rs.", format(amount, ".2f"))
    print("Ten-Day Total: Rs.", format(ten_day_total, ".2f"))
