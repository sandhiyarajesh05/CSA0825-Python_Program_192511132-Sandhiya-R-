# Constants
BASE_RATE = 30.00
FAT_STEP_VALUE = 0.40
SNF_STEP_VALUE = 0.30
STANDARD_FAT = 3.5
STANDARD_SNF = 8.5
DAYS = 10


def rate_per_litre(fat, snf):
    """Calculate the milk rate per litre."""
    fat_steps = round((fat - STANDARD_FAT) / 0.1)
    snf_steps = round((snf - STANDARD_SNF) / 0.1)

    rate = BASE_RATE + fat_steps * FAT_STEP_VALUE \
           + snf_steps * SNF_STEP_VALUE

    return round(rate, 2)


def payout(litres, fat, snf):
    """Calculate the payment for milk supplied."""
    rate = rate_per_litre(fat, snf)
    amount = round(litres * rate, 2)

    return amount


def ten_day_total(daily_amount):
    """Calculate the total payment for ten days."""
    return round(daily_amount * DAYS, 2)


# Get farmer details
farmer_id = input("Enter Farmer ID: ")
litres = float(input("Enter milk quantity: "))
fat = float(input("Enter fat percentage: "))
snf = float(input("Enter SNF percentage: "))

# Calculate payment
rate = rate_per_litre(fat, snf)
amount = payout(litres, fat, snf)
total = ten_day_total(amount)

# Display results
print("\n----- Milk Payment Receipt -----")
print("Farmer ID:", farmer_id)
print(f"Rate per Litre: Rs. {rate:.2f}")
print(f"Payment Amount: Rs. {amount:.2f}")
print(f"Ten-Day Total: Rs. {total:.2f}")
