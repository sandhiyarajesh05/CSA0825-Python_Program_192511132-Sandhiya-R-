import time

items = [f"Item{i}:Rs{i % 50}" for i in range(200000)]

# Method 1: Using +=
def build_plus(parts):
    text = ""
    for p in parts:
        text += p + ";"
    return text

# Method 2: Using join()
def build_join(parts):
    return ";".join(parts) + ";"

# Method 3: Using f-string
def build_fstring(parts):
    return "".join(f"{p};" for p in parts)


# Performance testing
for n in [1000, 10000, 200000]:
    data = items[:n]

    for name, func in [
        ("Plus", build_plus),
        ("Join", build_join),
        ("F-string", build_fstring)
    ]:
        times = []

        for i in range(3):
            start = time.perf_counter()
            result = func(data)
            end = time.perf_counter()
            times.append(end - start)

        average = sum(times) / 3
        print(name, n, "Average:", round(average, 4), "seconds")

    print()
