units = int(input("Enter units: "))
ration = input("Ration card (yes/no): ")
age = input("Age above 80 (yes/no): ")

if units <= 100:
    print("Full Subsidy")

if 101 <= units <= 200 and ration == "yes":
    print("Partial Subsidy")

if units > 200 and age == "yes":
    print("Special Subsidy")

if not (units <= 100 or
        (101 <= units <= 200 and ration == "yes") or
        (units > 200 and age == "yes")):
    print("No Subsidy")
