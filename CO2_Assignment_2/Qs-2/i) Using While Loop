otp = "1234"
attempts = 0

while attempts < 3:
    entry = input("Enter OTP: ")

    if entry == "":
        print("Blank entry! Try again.")
        continue

    attempts += 1

    if entry == otp:
        print("OTP Verified Successfully")
        break

    else:
        print("Wrong OTP")

else:
    print("Account Locked for 30 Minutes")
