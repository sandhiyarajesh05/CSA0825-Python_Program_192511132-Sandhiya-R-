def normalise(text):
    text = text.replace(" ", "")
    text = text.replace("-", "")
    return text.upper()


def is_valid(reg):
    if len(reg) not in (9, 10):
        return False

    return (reg[:2].isalpha() and
            reg[2:4].isdigit() and
            reg[4:-4].isalpha() and
            reg[-4:].isdigit())


def format_number(reg):
    return f"{reg[:2]} {reg[2:4]} {reg[4:-4]} {reg[-4:]}"


numbers = [
    "tn 09 ab 1234",
    "KA-01-M-0007",
    "TN9AB1234",
    "TN 22 1234 AB",
    "MH-12-PQ-4567",
    "TN-123-AB-1234"
]

for raw in numbers:
    reg = normalise(raw)

    if is_valid(reg):
        print(raw, "->", reg, "Valid")
        print("Receipt:", format_number(reg))
    else:
        print(raw, "->", reg, "INVALID")
